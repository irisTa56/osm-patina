.claude/settings.local.json
# Nested worktree checkouts the Claude Code harness creates here -- each is a
# full copy of the repo. Without this the link check would recurse into them:
# `hidden = true` in `lychee.toml` puts every dotdir in its walk.
.claude/worktrees/
.DS_Store
# A machine's own mise settings (mise.toml carries only what every machine
# shares).
mise.local.toml
# mise resolves the QA tools at `latest`; the lockfile is not pinned, so a
# locally-generated one is never committed.
mise.lock
.rumdl_cache/
# lychee's request cache, written by the shared `link-check:staged` task.
.lycheecache
